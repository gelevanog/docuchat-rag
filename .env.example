# DocuChat configuration. Copy to `.env` and adjust. Every variable is optional:
# the defaults run the whole stack offline with the deterministic `fake` provider.
# docker compose reads this file for variable substitution; the backend also reads
# backend/.env when run directly (uv run uvicorn ...).

# --- Providers -------------------------------------------------------------------
# Chat model: fake | openai | anthropic | openrouter
LLM_PROVIDER=fake
# Embedding model: fake | openai | openrouter   (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=fake
# Vector size stored in pgvector. Must match the embedding model (text-embedding-3-small: up to 1536).
# The column is created by the first migration: changing it later requires re-creating the database.
EMBEDDING_DIM=1536

# OpenAI (required if either provider above is `openai`)
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Azure OpenAI proxy, vLLM, Ollama, LiteLLM, ...)
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Upper bound on answer length in tokens
ANTHROPIC_MAX_TOKENS=16000
# Reasoning effort: low | medium | high
ANTHROPIC_EFFORT=medium

# OpenRouter (required if a provider is `openrouter`): one key for many models, including
# free ones. Free models are rate-limited (about 20 requests/min plus a daily cap), so requests
# are spaced OPENROUTER_MIN_INTERVAL_S apart and 429/5xx errors are retried with backoff.
# Free-model recipe: LLM_PROVIDER=openrouter, EMBEDDING_PROVIDER=openrouter, EMBEDDING_DIM=1024
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Up to 2 models tried in order when the chat model is unavailable or rate-limited
# (OpenRouter's `models` list). Keep them in a different family than JUDGE_MODEL.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# 1024-dimensional: set EMBEDDING_DIM=1024 before the database is first created
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
# Optional attribution headers (HTTP-Referer, X-Title) shown on openrouter.ai
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=DocuChat
OPENROUTER_MIN_INTERVAL_S=3
OPENROUTER_RETRIES=4
# First retry wait in seconds, doubled per attempt (a Retry-After header takes precedence)
OPENROUTER_BACKOFF_S=5

# Optional file cache for embeddings, so re-running ingestion or the evals costs no quota
EMBEDDING_CACHE_PATH=

# Delay between streamed words of the fake provider (ms), so the demo visibly streams
FAKE_STREAM_DELAY_MS=12

# --- Ingestion --------------------------------------------------------------------
# Target chunk size and overlap between consecutive chunks, in tokens (cl100k_base)
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
# Chunks sent to the embedding API per request
EMBEDDING_BATCH_SIZE=64
# Maximum upload size in megabytes
MAX_UPLOAD_MB=25
# Where uploaded originals are stored (inside the container: a named volume)
UPLOAD_DIR=./data/uploads

# --- Retrieval & chat -------------------------------------------------------------
# Chunks passed to the model per question
RETRIEVAL_TOP_K=6
# Candidates taken from each retriever (vector, full-text) before fusion
RETRIEVAL_CANDIDATES=30
# Reciprocal Rank Fusion constant k (60 is the value from the original paper)
RRF_K=60
# Previous question/answer pairs used for query rewriting and answering
HISTORY_TURNS=6

# --- Re-ranking -----------------------------------------------------------------------
# Re-orders the best fused candidates before the top RETRIEVAL_TOP_K go to the model:
#   none          - keep the fused order (default)
#   fake          - deterministic query-term overlap; offline demos and tests
#   cross-encoder - local ms-marco MiniLM cross-encoder on ONNX Runtime (CPU, ~0.2 s/question).
#                   Needs the `rerank` extra: `uv sync --extra rerank`, or BACKEND_EXTRAS=rerank
#                   for Docker (the model is baked into the image)
#   llm           - the chat model grades every candidate in one call (needs a real LLM_PROVIDER)
RERANKER=none
# Fused candidates handed to the re-ranker (the pool it chooses the top-k from)
RERANK_CANDIDATES=20
# Any fastembed cross-encoder, e.g. Xenova/ms-marco-MiniLM-L-12-v2 (slower, see the README)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Where the cross-encoder is downloaded to (default: fastembed's temp-dir cache)
RERANK_CACHE_DIR=
# Docker only: optional backend extras to install at build time (`rerank` or empty)
BACKEND_EXTRAS=

# --- Answer-quality judge (backend/scripts/eval_answers.py) -----------------------------
# fake (offline token-overlap heuristic) | openai | anthropic | openrouter (needs its API key)
JUDGE_PROVIDER=fake
# Judge model; empty = the provider's chat model. Prefer a different, stronger model (family)
# than the one writing the answers, e.g. dots-studio/dots-3-note-preview:free on OpenRouter.
JUDGE_MODEL=

# --- Database ---------------------------------------------------------------------
# Used by compose to create the database and build the backend's DATABASE_URL
POSTGRES_USER=docuchat
POSTGRES_PASSWORD=docuchat
POSTGRES_DB=docuchat
# Only for running the backend outside compose:
DATABASE_URL=postgresql+asyncpg://docuchat:docuchat@localhost:5432/docuchat
DB_ECHO=false

# --- Server -----------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# console (human-friendly) | json (log aggregation)
LOG_FORMAT=console
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Docker compose ports & frontend ------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
# URL the browser uses to reach the API (inlined into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
